{
  "name": "tourze/bundle-dependency",
  "description": "Bundle dependency resolver for Symfony",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Tourze",
      "email": "tourze@example.com"
    }
  ],
  "require": {
    "symfony/http-kernel": "^7.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "symfony/framework-bundle": "^7.4",
    "tourze/symfony-testing-framework": "2.0.*"
  },
  "autoload": {
    "psr-4": {
      "Tourze\\BundleDependency\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tourze\\BundleDependency\\Tests\\": "tests/"
    }
  }
}